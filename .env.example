# Copy to .env and fill in. Never commit the filled copy.
# In Coolify these are set as environment variables on the service instead.

# --- required ---------------------------------------------------------------
# openssl rand -hex 32
OMICSLAB_JWT_SECRET=
# The Postgres volume keeps whatever password it was first initialised with:
# changing this later does nothing until the volume is recreated.
POSTGRES_PASSWORD=

# --- deployment identity ----------------------------------------------------
OMICSLAB_ENVIRONMENT=production
# The build context has no .git, so the commit cannot be self-reported: set
# this from the deployment (in Coolify, a build variable).
OMICSLAB_RELEASE=dev

# --- optional ---------------------------------------------------------------
POSTGRES_USER=omicslab
POSTGRES_DB=omicslab
WEB_PORT=8080
# Only needed for API clients that are not the bundled front end; the front end
# is served same-origin through nginx.
OMICSLAB_CORS_ORIGINS=https://omicslab.example.com
# Build Scanpy/leidenalg/GSEApy into the API image. Required for the Core and
# Advanced tracks; roughly triples image size and build time.
INCLUDE_SCIENCE=false
OMICSLAB_RUN_WORKER_THREADS=2
OMICSLAB_LOG_JSON=true
