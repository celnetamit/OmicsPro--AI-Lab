# Copy to .env and fill in. Never commit the filled copy.
# In Coolify these are set as environment variables on the service instead.

# --- required ---------------------------------------------------------------
# openssl rand -hex 32
OMICSLAB_JWT_SECRET=
# The Postgres volume keeps whatever password it was first initialised with:
# changing this later does nothing until the volume is recreated.
POSTGRES_PASSWORD=

# --- deployment identity ----------------------------------------------------
OMICSLAB_ENVIRONMENT=production
# The build context has no .git, so the commit cannot be self-reported: set
# this from the deployment (in Coolify, a build variable).
OMICSLAB_RELEASE=dev

# --- optional ---------------------------------------------------------------
POSTGRES_USER=omicslab
POSTGRES_DB=omicslab
# Local runs only (docker-compose.override.yml): the port on your machine.
WEB_PORT=8080
# Only needed for API clients that are not the bundled front end; the front end
# is served same-origin through nginx.
OMICSLAB_CORS_ORIGINS=https://omicslab.example.com
# Build Scanpy/leidenalg/GSEApy into the API image. Required for the Core and
# Advanced tracks; roughly triples image size and build time.
INCLUDE_SCIENCE=false
# Tier every NanoSchool account starts with in this lab. Leave as basic for
# anything real learners use: anything higher hands them the paid features.
# expert is for testing and building, so every screen is reachable.
# (Called OMICSLAB_OPEN_ACCESS_TIER before the lab moved to NanoSchool sign-in;
#  docker-compose.yml still reads that name, so an existing deployment's
#  configuration keeps working.)
OMICSLAB_GRANTED_TIER=basic

# --- NanoSchool (live-labs.org) ---------------------------------------------
# This lab has no sign-in of its own. A learner opens it from their NanoSchool
# dashboard with a one-shot launch token, and the API verifies that token with
# the hub before issuing a session — so the hub must be reachable from the API
# container, not only from the browser.
#
# One value, two places: VITE_HUB_URL is baked into the bundle (and into the
# content-security policy that lets the browser reach the hub for feedback and
# the review forms), and the API reads OMICSLAB_HUB_BASE_URL, which
# docker-compose.yml sets from it. Override both only for a staging hub.
VITE_HUB_URL=https://live-labs.org
# This lab's slug in the hub's catalogue, and where it answers. Sent with each
# verification so the hub can resolve which lab is being launched.
OMICSLAB_LAB_SLUG=omicslab
OMICSLAB_LAB_PUBLIC_URL=https://omicslab.live-labs.org
# Appoints a lab administrator by email, read by scripts/seed.py. The account
# becomes usable when that person launches the lab from NanoSchool. Not needed
# for anyone whose hub role is already ADMIN or SUPER_ADMIN.
OMICSLAB_ADMIN_EMAIL=
# Local development only, and refused in production: lets
# POST /api/auth/dev-session open a lab session with no hub at all. The front
# end needs its own switch to match (VITE_DISABLE_LAB_AUTH=true at build time).
OMICSLAB_DEV_LAB_SESSION=false
OMICSLAB_RUN_WORKER_THREADS=2
OMICSLAB_LOG_JSON=true
